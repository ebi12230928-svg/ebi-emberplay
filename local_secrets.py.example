# ⚠️ これはテンプレートです。このファイル自体(local_secrets.py.example)はGitHubに
# アップロードして問題ありませんが、実際の値を書き込んだファイルは
# 「local_secrets.py」という名前で、PythonAnywhereのサーバー上に直接作成してください。
# (GitHub経由でアップロードすると、シークレットキーが外部に漏れる可能性があるため、
#  .gitignoreでlocal_secrets.pyそのものはアップロード対象から除外しています)
#
# 作成手順:
# 1. PythonAnywhereの「Files」タブを開く
# 2. ~/emberplay/ フォルダの中に、新しいファイル「local_secrets.py」を作成する
# 3. このファイルの中身を参考に、実際の値を書き込んで保存する
# 4. 「Web」タブで「Reload」する

DISCORD_CLIENT_ID = "ここにDiscordのクライアントIDを貼り付け"
DISCORD_CLIENT_SECRET = "ここにDiscordのクライアントシークレットを貼り付け"
DISCORD_REDIRECT_URI = "https://あなたのドメイン/discord/callback"

# 広告(Google AdSenseなど)。未設定のままなら、広告は一切表示されません。
ADSENSE_PUBLISHER_ID = ""  # 例: "ca-pub-1234567890123456"
ADSENSE_AD_SLOT_BANNER = ""  # 例: "1234567890"
